{
  "name": "my_portfolio",
  "version": "1.0.0",
  "description": "Responsive Portfolio Website",
  "homepage": "https://9smart.life/",
  "scripts": {
    "sass": "sass --watch --no-source-map scss/main.scss:dist/css/main.css",
    "build:css": "sass --no-source-map scss/main.scss dist/css/main.css",
    "photos": "node scripts/add-photos.js",
    "images": "node scripts/rebuild-images.js",
    "deploy": "npm run build:css && gh-pages -d dist"
  },
  "author": "Smart",
  "license": "MIT",
  "devDependencies": {
    "gh-pages": "^6.0.0",
    "sass": "^1.92.1"
  }
}
